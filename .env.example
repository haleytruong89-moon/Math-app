# Copy to .env.local for local dev. On Vercel: Settings → Environment Variables.
# Public (safe in the browser) — Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only secrets — set on Vercel directly, never commit, never paste in chat
SUPABASE_SECRET_KEY=
CRON_SECRET=
